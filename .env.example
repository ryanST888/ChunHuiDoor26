PUBLIC_SITE_URL=https://www.chunhuidoors.com

# Headless CMS content endpoint. Leave disabled to use src/content/site.ts.
# This endpoint can return SiteData directly, or wrapped as { "data": { "content": ... } }.
CHUNHUI_CMS_ENABLED=false
CHUNHUI_CMS_CONTENT_URL=
CHUNHUI_CMS_API_TOKEN=

# 0 means read fresh from the CMS during build/dev. Ignored when CHUNHUI_CMS_ENABLED=false.
CHUNHUI_CMS_REVALIDATE_SECONDS=60
