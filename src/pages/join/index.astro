---
import { ContactFormIsland } from "@/components/ContactFormIsland";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSiteData } from "@/content/cms";

const siteData = await getSiteData();
const { advantages, company, contact, stats } = siteData;

const partnerSteps = [
  { title: "区域沟通", desc: "确认城市、商圈、门店计划和合作意向。" },
  { title: "产品匹配", desc: "结合当地客群，规划主推品类、样板和展示方式。" },
  { title: "门店落地", desc: "提供开业前后产品、培训、运营和服务支持。" },
];
---

<BaseLayout active="join" siteData={siteData} title="招商加盟" description="春晖门业面向全国经销商提供木门加盟与供应链支持。">
  <section class="bg-ink pt-36 text-white lg:pt-44">
    <div class="mx-auto grid w-full max-w-[1500px] items-end gap-12 px-4 pb-16 sm:px-6 lg:grid-cols-[minmax(0,0.9fr)_440px] lg:px-8 lg:pb-24">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-gold">Partner Program</p>
        <h1 class="mt-5 font-serif-cn text-5xl font-bold leading-tight tracking-normal sm:text-6xl lg:text-7xl">成为春晖门业城市合作伙伴</h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-white/68 lg:text-lg">{contact.ctaSub}</p>
      </div>
      <aside class="rounded-lg border border-white/15 bg-white/[0.06] p-7 backdrop-blur">
        <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-gold">Hotline</p>
        <a class="mt-4 block font-serif-cn text-4xl font-bold" href={`tel:${company.phone}`}>{company.phone}</a>
        <p class="mt-4 text-sm leading-7 text-white/58">{contact.workHours}</p>
        <a class="mt-7 inline-flex h-12 items-center justify-center rounded-md bg-clay px-6 text-sm font-extrabold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-[#963126]" href={`tel:${company.phone}`}>电话沟通</a>
      </aside>
    </div>
  </section>

  <section class="bg-paper py-16">
    <div class="mx-auto grid w-full max-w-[1500px] gap-4 px-4 sm:px-6 md:grid-cols-4 lg:px-8">
      {stats.map(item => (
        <div class="rounded-lg border border-ink/10 bg-white p-6 shadow-[0_18px_54px_rgba(21,17,12,0.08)]">
          <strong class="block font-serif-cn text-4xl text-clay">{item.number}</strong>
          <p class="mt-2 text-sm text-ink/58">{item.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto w-full max-w-[1500px] px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-clay">Support</p>
        <h2 class="mt-4 font-serif-cn text-4xl font-bold leading-tight tracking-normal lg:text-5xl">加盟支持体系</h2>
        <p class="mt-5 text-base leading-8 text-ink/62">春晖门业把合作重点放在产品供应、门店展示、培训运营和稳定交付上，帮助经销商更快进入本地家居市场。</p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {advantages.map(item => (
          <article class="rounded-lg border border-ink/10 bg-paper p-7">
            <span class="text-xs font-extrabold uppercase tracking-[0.18em] text-clay">{item.icon}</span>
            <h3 class="mt-5 font-serif-cn text-2xl font-bold">{item.title}</h3>
            <p class="mt-4 text-sm leading-7 text-ink/58">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink py-20 text-white lg:py-24">
    <div class="mx-auto grid w-full max-w-[1500px] gap-10 px-4 sm:px-6 lg:grid-cols-[360px_minmax(0,1fr)] lg:px-8">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-gold">Process</p>
        <h2 class="mt-4 font-serif-cn text-4xl font-bold leading-tight tracking-normal lg:text-5xl">合作流程</h2>
        <p class="mt-5 text-base leading-8 text-white/60">先沟通城市与门店计划，再进入样板、产品和运营支持确认。</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {partnerSteps.map((item, index) => (
          <article class="rounded-lg border border-white/12 bg-white/[0.06] p-6">
            <span class="font-serif-cn text-4xl text-gold">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="mt-8 font-serif-cn text-2xl font-bold">{item.title}</h3>
            <p class="mt-4 text-sm leading-7 text-white/58">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper py-20 lg:py-24">
    <div class="mx-auto grid w-full max-w-[1500px] gap-6 px-4 sm:px-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(360px,0.7fr)] lg:px-8">
      <div class="rounded-lg bg-white p-7 shadow-soft lg:p-10">
        <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-clay">Next Step</p>
        <h2 class="mt-4 font-serif-cn text-4xl font-bold leading-tight tracking-normal lg:text-5xl">留下合作意向，或直接电话沟通</h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-ink/62">招商合作更适合先通过电话确认区域、门店计划和合作方式。也可以提交表单，后续接入 CMS/CRM 后直接同步后台。</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="inline-flex h-12 items-center justify-center rounded-md bg-clay px-6 text-sm font-extrabold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-[#963126]" href={`tel:${company.phone}`}>电话沟通</a>
          <a class="inline-flex h-12 items-center justify-center rounded-md border border-ink/10 bg-white px-6 text-sm font-extrabold text-ink transition hover:-translate-y-0.5 hover:border-clay hover:text-clay" href="/products/">查看产品</a>
        </div>
      </div>

      <ContactFormIsland client:visible />
    </div>
  </section>
</BaseLayout>
